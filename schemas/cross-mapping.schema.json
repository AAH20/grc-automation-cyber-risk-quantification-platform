{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2zsoc.com/schemas/grc-decisiongraph/cross-mapping-1.0.json",
  "title": "GRC DecisionGraph directional cross-mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "target", "strength", "coverage_pct", "rationale", "reviewer", "mapping_version"],
  "properties": {
    "source": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "strength": {"enum": ["EXACT", "SUBSTANTIAL", "PARTIAL", "RELATED"]},
    "coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "rationale": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "mapping_version": {"type": "string", "minLength": 1}
  }
}
